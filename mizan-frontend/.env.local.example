# Frontend environment variables template — copy to .env.local and fill in values
# IMPORTANT: use API origin only (no /api/v1 suffix). The frontend appends /api/v1 internally.

# Empty = Next.js proxy to backend (recommended for npm run dev, no CORS issues)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_BACKEND_ORIGIN=http://127.0.0.1:8000
# Optional: WebSocket origin if the browser cannot reach BACKEND_ORIGIN (e.g. phone on LAN)
# NEXT_PUBLIC_NOTIFICATIONS_WS_ORIGIN=http://192.168.1.10:8000
# Or call backend directly (requires matching BACKEND_CORS_ORIGINS):
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/api/v1/voice/realtime
NEXT_PUBLIC_AI_VOICE_VOLUME=1
NEXT_PUBLIC_AI_VOICE_BOOST=1.8
